<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Biometric Permission -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Location Permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Internet for maps -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MentalHealthMoodTracker"
        tools:targetApi="31">

        <!-- Google Maps API Key - YOU NEED TO REPLACE THIS -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyB4iQP7H0vCx0qw6EsULJ9zkZ33rt_UFSo"/>

        <!-- Main Activity (Launcher) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MentalHealthMoodTracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Biometric Auth Activity -->
        <activity
            android:name=".ui.BiometricAuthActivity"
            android:exported="false"
            android:theme="@style/Theme.MentalHealthMoodTracker"/>

        <!-- Dashboard Activity -->
        <activity
            android:name=".ui.DashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.MentalHealthMoodTracker"/>

        <!-- Add Mood Activity -->
        <activity
            android:name=".ui.AddMoodActivity"
            android:exported="false"
            android:theme="@style/Theme.MentalHealthMoodTracker"/>

        <!-- Mood History Activity -->
        <activity
            android:name=".ui.MoodHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.MentalHealthMoodTracker"/>

        <!-- Stress Relief Places Activity -->
        <activity
            android:name=".ui.StressReliefPlacesActivity"
            android:exported="false"
            android:theme="@style/Theme.MentalHealthMoodTracker"/>

        <!-- Breathing Exercise Activity -->
        <activity
            android:name=".ui.BreathingExerciseActivity"
            android:exported="false"
            android:theme="@style/Theme.MentalHealthMoodTracker"/>

        <!-- Resources Activity -->
        <activity
            android:name=".ui.ResourcesActivity"
            android:exported="false"
            android:theme="@style/Theme.MentalHealthMoodTracker"/>

    </application>

</manifest>